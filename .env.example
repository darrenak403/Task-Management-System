# Local Compose only. Replace these values before any shared environment.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
API_PORT=4000
LOG_LEVEL=info
TRUSTED_PROXY_CIDRS=

POSTGRES_USER=tms_app
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=task_management
DATABASE_URL=postgresql://tms_app:local_only_change_me@db:5432/task_management

# No provider key or model is configured here; each account supplies one Gemini key and model in the application.
# API-only master keyring encrypts each user's Gemini key at rest; it is not a provider API key.
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_KEYRING=
AI_MAX_INPUT_TOKENS=20000
AI_MAX_OUTPUT_TOKENS=8000
AI_PROVIDER_TIMEOUT_MS=60000
AI_JOB_TIMEOUT_MS=180000

# Web. The browser only ever calls same-origin `/api/*`; nothing here is exposed to the browser.
# Host port of the web dev server (`task dev`) and of the web container. Keep APP_ORIGIN on the same port.
WEB_PORT=3000
# Where the web dev server forwards `/api/*`. The web container ignores it and always uses the API container.
API_PROXY_TARGET=http://localhost:4000

# Demo data for `task seed` and the production `seed` step: set SEED_DEMO_DATA=yes and a password of 8-128 characters shared by the demo users.
SEED_DEMO_DATA=no
SEED_DEMO_PASSWORD=
