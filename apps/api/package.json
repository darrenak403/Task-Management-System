{
  "name": "@task-management/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --no-file-parallelism --maxWorkers=1",
    "cleanup:expired-sessions": "node dist/jobs/cleanup-expired-sessions.js",
    "cleanup:realtime-outbox": "node dist/jobs/cleanup-realtime-outbox.js",
    "cleanup:ai-planner-retention": "node dist/jobs/cleanup-ai-planner-retention.js",
    "post-restore:realtime": "node dist/jobs/rotate-realtime-epoch.js",
    "post-restore:backend": "node dist/jobs/post-restore-backend.js",
    "reconcile:ai-quota": "node dist/jobs/reconcile-ai-quota.js",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "smoke": "tsx tests/smoke/api-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/swagger-ui-express": "4.1.8",
    "prisma": "7.10.0",
    "tsx": "4.23.15"
  }
}
